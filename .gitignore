# Generated by Cargo
# will have compiled files and executables
/debug
/target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover and other JetBrains IDEs
#.idea/

# macOS Finder metadata
.DS_Store

# Claude Code personal/local overrides (never committed)
.claude/settings.local.json

# Claude Code agent worktrees (isolated per-agent checkouts, never committed)
.claude/worktrees/

# The rendered book and the assembled site, once the documentation site lands.
/website/book/book/
/_site/

# The container build context: the release lane stages one static binary per
# platform under dist/<os>_<arch>/. Built artefacts, never committed.
/dist/

# Operator-provided secret files for a local quickstart. Never committed.
/secrets/

# The CycloneDX documents cargo-cyclonedx writes beside each member's
# Cargo.toml during a release rehearsal.
*.cdx.json

# Coverage output from the instrumented test run.
lcov.info

# Node tooling pulled in by a local Antora or mermaid-cli run.
node_modules/

# The fuzz crate builds outside the workspace; its build tree, corpora and
# crash artifacts never enter the repository.
fuzz/target/
fuzz/corpus/
fuzz/artifacts/
fuzz/coverage/
