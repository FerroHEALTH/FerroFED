# The overrides the performance gate (scripts/perf/gate.sh) gives this tree's
# gateway when it runs it as an arm, over this tree's perf/ferrofed.toml. A
# tree carries its own, so a change to the configuration keys reaches the
# arm whose binary reads them and never the other. One NAME=VALUE per line;
# the gate fills @PORT@ (the gateway's port) and @DIR@ (its work directory,
# where it writes the store URL), refuses any other placeholder, and sets
# FERROFED_CONFIG and FERROFED__USAGE_REPORT__ENABLED=false itself. No
# specification governs this: our own design.
FERROFED__SERVER__LISTEN=127.0.0.1:@PORT@
FERROFED__GATEWAY__PUBLIC_URL=http://127.0.0.1:@PORT@
FERROFED__AUTH__DPOP__EXTERNAL_URL=http://127.0.0.1:@PORT@
FERROFED__SIGNING__JWKS_URI=http://127.0.0.1:@PORT@/.well-known/jwks.json
FERROFED__STORE__URL_FILE=@DIR@/store-url
