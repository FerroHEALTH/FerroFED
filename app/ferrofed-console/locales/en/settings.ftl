# The deployment-wide settings of the configuration page.
setting-archetype-map = Category map by archetype
setting-archetype-map-desc = Archetype ids, each mapped to the categories of the data under it.
setting-backend = Backend
setting-backend-desc = Where the stored queries are kept: redb, postgres or files.
setting-best-effort = Best effort
setting-best-effort-desc = A client may ask for the rows that came back when a node does not answer.
setting-connection = Connection
setting-connection-desc = The PostgreSQL connection string, a secret, named by the file it is read from.
setting-disclose = Disclose exclusions
setting-disclose-desc = Name a node the consent pre-filter excludes as consent-denied. Off, it reads as a node without the patient, as Regulation (EU) 2025/327 Art 8 may require.
setting-emergency = In an emergency
setting-emergency-desc = Whether the consent pre-filter still applies when the caller declares an emergency purpose: apply, or pass-to-node.
setting-emergency-purposes = Emergency purposes
setting-emergency-purposes-desc = Purposes of use that mark an emergency access.
setting-fhir-base = Base
setting-fhir-base-desc = Where the exchange-format face is served, beside the openEHR API.
setting-localizer-budget = Localizer budget
setting-localizer-budget-desc = How long the localizer may take, in milliseconds, out of the overall timeout.
setting-localizer-fails = When the localizer fails
setting-localizer-fails-desc = closed asks no node and says why; ask-all asks every node.
setting-node-selection = Node selection
setting-node-selection-desc = Which nodes a patient's query asks: localized, the nodes the localizer names, or ask-all, every node.
setting-overall-timeout = Overall timeout
setting-overall-timeout-desc = How long a whole query may take, in milliseconds. With the 1,000 ms margin it stays below each replica's own request timeout.
setting-paging = Paging
setting-paging-desc = bounded asks each node for offset plus limit rows and merges them within the window; reject refuses an offset.
setting-paging-window = Paging window
setting-paging-window-desc = The most rows, offset plus limit, one page may ask of a node; a positive number.
setting-per-node-timeout = Per-node timeout
setting-per-node-timeout-desc = How long one node may take, in milliseconds: no more than the overall timeout.
setting-received = Received categories
setting-received-desc = The categories of document the face accepts.
setting-retention = Retention
setting-retention-desc = Years each access record is kept: at least 3.
setting-rows-per-node = Rows per node
setting-rows-per-node-desc = The most rows read of one node for a query without LIMIT; a positive number.
setting-store-path = Path
setting-store-path-desc = The redb store file, or the directory the files backend reads.
setting-stored-fan-out = Stored-query fan-out
setting-stored-fan-out-desc = Send each new stored version on to the nodes as well.
setting-template-fan-out = Template upload fan-out
setting-template-fan-out-desc = Send an uploaded template to several nodes in one request.
setting-template-map = Category map by template
setting-template-map-desc = Template ids, each mapped to the categories of the data under it.
setting-unknown = A setting this console does not describe.
setting-url-lifetime = Document URL lifetime
setting-url-lifetime-desc = How long a listed document's URL stays valid, in seconds: at least 1.
settings-change-one = Change a setting before you save.
settings-changed-only-hint = Only the settings you change are saved; a list or a table, and a secret, are changed by an import.
settings-edit = Edit
settings-edit-title = Edit { $tab }
settings-file-line = Revisions are off on this gateway: every setting is read from its configuration file and environment, and shown here read-only.
settings-file-subtitle = What the configuration file and the environment set, as the gateway runs it.
settings-intro-access-log = How each access record is classified and kept.
settings-intro-consent = What callers learn about consent.
settings-intro-edit = A draft of this tab, based on revision { $base }. Saved, it is a revision you apply as any other.
settings-intro-edit-first = A draft of this tab. Saved, it is a revision you apply as any other.
settings-intro-fan-out = How a query is paged, and what is sent on to the nodes.
settings-intro-federation = How a query fans out to the nodes and when it gives up.
settings-intro-fhir = The face that serves and receives the European exchange format.
settings-intro-stored-queries = The store the stored queries are kept in; the stored versions are listed below.
settings-mapped = { $count } ids mapped
settings-ms = { $value } ms
settings-next-value = { $value } at the next start
settings-not-set = Not set
settings-off = Off
settings-on = On
settings-read-only-here = Changed by an import
settings-rows = { $value } rows
settings-seconds = { $value } s
settings-secret-set-file = Set, read from
settings-secret-set-inline = Set in the file
settings-source-default = the default
settings-source-environment = from an environment override
settings-source-file = from the configuration file
settings-source-revision = from revision { $revision }
settings-tab-access-log = Access log
settings-tab-consent = Consent
settings-tab-fan-out = Fan-out and paging
settings-tab-federation = Federation behaviour
settings-tab-fhir = FHIR face
settings-unreadable = The running configuration could not be read from { $replica }.
settings-years = { $value } years
