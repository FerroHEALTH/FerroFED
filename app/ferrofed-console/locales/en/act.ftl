# What the forms answer.

clear-action = Clear an EHR id
clear-title = Clear a held EHR id
clear-ehr-id-label = EHR id
clear-ehr-id-help = The whole EHR id, as the incident names it.
clear-replica-label = Replica
clear-every-replica = Every replica, one after another
clear-recorded = The clear takes no reason and is recorded with your name in the integrity log.
clear-submit = Clear
clear-no-admin = The console is configured with no admin listener, so it offers no clear.
clear-name-ehr-id = Name the EHR id to clear.
clear-choose-replica = Choose a replica the console names.
clear-confirm = Confirm the clear in its confirmation step to run it.
clear-done = The EHR id was cleared.
clear-partly = The EHR id was cleared at some replicas.
clear-not-done = The EHR id was not cleared.
clear-held-nothing = it held nothing
clear-held-at = it held it at { $claimants }
clear-replica-done = { $replica } cleared it: { $held }.
clear-replica-refused = { $replica } refused the clear ({ $status }).
clear-replica-unknown = { $replica } gave no answer, so whether it cleared it is not known.
