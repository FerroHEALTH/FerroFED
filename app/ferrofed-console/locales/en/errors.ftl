# The error pages.

not-found-title = Not found
not-found-body = The console has no page at { $path }. The address may be mistyped, or what it named may have left the federation.
not-found-dashboard = Back to the dashboard
not-found-organisations = Organisations
forbidden-title = No operator scope
forbidden-body = The gateway's operator surface needs a token that carries its operator scope, and yours does not.
forbidden-hint = Whoever runs your identity provider can grant the scope.
unreadable-title = The console cannot read its sessions
unreadable-body = The console cannot tell whether you are signed in, so it shows nothing. Whoever runs the console can see why in its log.
