#
# Example variables for the release compose.yaml, matching registry.toml
# beside this file. Copy it beside compose.yaml as .env and put your own
# values in. Every value here is a placeholder: example.org hosts and
# identifiers in the urn:oid:2.999 example arc. The two credential files it
# names go in secrets/: node-a holds node A's bearer token and node-b node
# B's password. No value here is a secret.

FERROFED_FEDERATION_ID=example-federation
FERROFED_PIXM_URL=https://pix.example.org/fhir/
FERROFED_PIXM_MEMBERS='{ "node-a" = "urn:oid:2.999.10", "node-b" = "urn:oid:2.999.20" }'
FERROFED_CREDENTIALS='{ "node-a-query" = { bearer_token_file = "/run/secrets/ferrofed/node-a" }, "node-b-query" = { user = "ferrofed", password_file = "/run/secrets/ferrofed/node-b" } }'
