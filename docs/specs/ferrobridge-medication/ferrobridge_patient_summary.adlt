-- SPDX-FileCopyrightText: Cadasto B.V.
-- SPDX-License-Identifier: BUSL-1.1
-- FerroBRIDGE's patient summary template over published CKM archetypes
-- (fixtures/ckm/medication, discharge and library): a health summary
-- COMPOSITION with six sections, each an ad hoc SECTION named for its HL7
-- Europe Patient Summary section but the immunisations: the problem list
-- holding EVALUATION.problem_diagnosis.v1, the allergies and intolerances
-- holding EVALUATION.adverse_reaction_risk.v2, the medication summary holding
-- INSTRUCTION.medication_order.v3 and ACTION.medication.v1, the history of
-- procedures holding ACTION.procedure.v1, the medical devices holding
-- EVALUATION.device_summary.v0, and the immunisations, the
-- vaccination list SECTION whose "Vaccinations administered" slot holds
-- ACTION.medication.v1. The section path places an entry. No specification
-- governs this template: our own design. Node identifiers are at-coded, the
-- ADL 1.4 codes of the CKM sources.
template (adl_version=2.4.0; rm_release=1.1.0)
    openEHR-EHR-COMPOSITION.ferrobridge_patient_summary.v1.0.0

specialize
    openEHR-EHR-COMPOSITION.health_summary.v1

language
    original_language = <[ISO_639-1::en]>

description
    lifecycle_state = <"unmanaged">
    original_author = <
        ["name"] = <"FerroBRIDGE">
    >
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"The HL7 Europe Patient Summary of FerroBRIDGE.">
        >
    >

definition
    COMPOSITION[at0000.1] matches {
        content matches {
            use_archetype SECTION[at0000.2, openEHR-EHR-SECTION.adhoc-ferrobridge_medication_summary.v1]
            use_archetype SECTION[at0000.3, openEHR-EHR-SECTION.immunisation_list-ferrobridge.v0]
            use_archetype SECTION[at0000.4, openEHR-EHR-SECTION.adhoc-ferrobridge_problem_list.v1]
            use_archetype SECTION[at0000.5, openEHR-EHR-SECTION.adhoc-ferrobridge_allergies.v1]
            use_archetype SECTION[at0000.6, openEHR-EHR-SECTION.adhoc-ferrobridge_procedures.v1]
            use_archetype SECTION[at0000.7, openEHR-EHR-SECTION.adhoc-ferrobridge_devices.v1]
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["at0000.1"] = <
                text = <"Patient summary">
                description = <"The problems, allergies, medication summary, procedures, medical devices and immunisations of a patient summary.">
            >
            ["at0000.2"] = <
                text = <"Medication summary">
                description = <"The medicines the patient takes, recorded as medication orders or actions.">
            >
            ["at0000.3"] = <
                text = <"Immunisations">
                description = <"The vaccines the patient received, recorded as medication actions.">
            >
            ["at0000.4"] = <
                text = <"Problem list">
                description = <"The problems and diagnoses of the patient.">
            >
            ["at0000.5"] = <
                text = <"Allergies and intolerances">
                description = <"The risks of an adverse reaction the patient carries.">
            >
            ["at0000.6"] = <
                text = <"History of procedures">
                description = <"The procedures the patient underwent.">
            >
            ["at0000.7"] = <
                text = <"Medical devices">
                description = <"The medical devices fitted to or implanted in the patient.">
            >
        >
    >

------------------------------------------------------------------------
template_overlay
    openEHR-EHR-SECTION.adhoc-ferrobridge_medication_summary.v1.0.0

specialize
    openEHR-EHR-SECTION.adhoc.v1

language
    original_language = <[ISO_639-1::en]>

description
    lifecycle_state = <"unmanaged">
    original_author = <
        ["name"] = <"FerroBRIDGE">
    >
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"The HL7 Europe Patient Summary of FerroBRIDGE.">
        >
    >

definition
    SECTION[at0000.1] matches {
        name matches {
            DV_TEXT matches {
                value matches {"Medication summary"}
            }
        }
        items matches {
            use_archetype INSTRUCTION[at0000.2, openEHR-EHR-INSTRUCTION.medication_order.v3]
            use_archetype ACTION[at0000.3, openEHR-EHR-ACTION.medication.v1]
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["at0000.1"] = <
                text = <"Medication summary">
                description = <"Medication summary">
            >
            ["at0000.2"] = <
                text = <"Medication order">
                description = <"Medication order">
            >
            ["at0000.3"] = <
                text = <"Medication action">
                description = <"A medicine the patient takes, recorded as a medication action.">
            >
        >
    >

